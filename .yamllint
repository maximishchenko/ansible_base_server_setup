---
extends: default
# Не линтовать то, что игнорирует git (.venv/, .ansible/, vault, реальный inventory…).
ignore-from-file: .gitignore
rules:
  # Ansible требует длинные строки для команд
  line-length:
    max: 160
    allow-non-breakable-words: true
  # В Ansible часто используют true/false без кавычек
  truthy:
    check-keys: false
  # Отступы строго 2 пробела для Ansible
  indentation:
    spaces: 2
    indent-sequences: consistent
